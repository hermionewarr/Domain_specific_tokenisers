# Copy this file to paths.env and fill in the paths you have.
# Empty values are ignored. Variables already set in the environment win.

# Root used only when the specific directories below are left empty.
SCRIBE_DATA_ROOT=

# Report CSVs. See README for the expected filenames and columns.
SCRIBE_OUH_DIR=
SCRIBE_MIMIC_DIR=
SCRIBE_CTRATE_DIR=

# JSONL with an "abstract" field, one PubMed abstract per line.
SCRIBE_PUBMED_ABSTRACTS=

# Plain-text dumps written while training domain tokenisers.
SCRIBE_TEXT_DIR=

# Where trained Hugging Face tokeniser folders are saved and loaded.
SCRIBE_VOCAB_DIR=

# Language-model checkpoints, generated reports, and metric tables.
SCRIBE_RUNS_DIR=

# Optional. Required only for the clinical metrics that use them.
SCRIBE_CHEXPERT_LABELER=
SCRIBE_CHEXBERT_WEIGHTS=
SCRIBE_CHEXPERT_CONDA=chexpert-label
SCRIBE_CONDA=conda
SCRIBE_EVAL_DIR=
SCRIBE_GREEN_DIR=
SCRIBE_CTCLIP_TEXT_CLASSIFIER=
SCRIBE_RADBERT_CHECKPOINT=
SCRIBE_METAMAP_DIR=
